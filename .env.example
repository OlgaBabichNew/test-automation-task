# -----------------------------------------------------------------------
# .env.example — copy this file to .env and adjust values as needed.
#
# .env is listed in .gitignore and is NEVER committed to the repository.
# This file (.env.example) IS committed — it documents every variable
# the project understands without leaking real credentials.
#
# In CI (GitHub Actions, GitLab CI, etc.) set these as environment
# variables in the pipeline settings instead of using a .env file.
# -----------------------------------------------------------------------

# Base URL of the application under test.
# Override this to point at a staging / dev environment without touching code.
BASE_URL=https://www.saucedemo.com

# Browser to use: chromium | firefox | webkit
BROWSER=chromium

# Run browser without a visible window.
# Set to false when debugging locally to watch the browser in real time.
HEADLESS=false

# --- Credentials ---------------------------------------------------------
# These are the publicly documented demo credentials for saucedemo.com.
# In a real project these would be secret and injected by the CI system.
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PASSWORD=secret_sauce
